# Engine settings (all optional; /lotnok sets token, key and treasury)
PORT=5043
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The cycle: Oil Reserve (fee escrow) size in ETH that triggers each step, in order
# feeding (the emergency meeting) → keeper (treasury) → feeding …
# There is no buyback and no burn step.
FEEDING_ETH=0.02
KEEPER_ETH=0.025
# Emergency meetings pay this many Board seats, biggest balances first, split by balance
FEEDING_TOP_N=10
# Benches inside the top N, "upTo:percent": No. 1–5 share 70% (0.014 ETH), No. 6–10 share 30% (0.006), by balance within each
FEEDING_TIERS=5:70,10:30
MIN_BALANCE=100000
# First $OILCEO must be this old (hours) to be seated; stops buying in right before a meeting
MIN_HOLD_HOURS=0
CONTRACTS_ARE_SELLS=1
# extra sell destinations, comma separated (e.g. the Uniswap v4 PoolManager after graduation)
SELL_SINKS=
# needed for every change to token/key/treasury
ADMIN_SECRET=
# Connect X (optional). An X developer app, type "Web App", callback <SITE_URL>/api/x/callback.
# Leave empty and the "Connect X" button stays hidden.
SITE_URL=https://your-domain.example
X_CLIENT_ID=
X_CLIENT_SECRET=
# 1 lets the demo edition try a real X sign-in (nothing saved).
X_DEMO=0
# Post the well's marks (10%, 25% … dry) to the project's X account. All four or nothing.
X_POST_API_KEY=
X_POST_API_SECRET=
X_POST_ACCESS_TOKEN=
X_POST_ACCESS_SECRET=

# How often the engine reads new blocks (seconds). 3 keeps the Board live.
POLL_INTERVAL_SECONDS=3

# The well (display only, never touches funds): barrels in the well at launch, and the
# smallest buy (whole tokens) that pumps one. One buy transaction pumps at most one barrel.
WELL_BARRELS=5000
BARREL_MIN_TOKENS=10000
